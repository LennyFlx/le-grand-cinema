DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Stripe (mode test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails : console par défaut.
# Pour l'envoi réel : EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS : généralement port 587 ; TLS et SSL ne peuvent pas être actifs ensemble.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=5
# L'adresse d'expédition doit être autorisée par votre fournisseur SMTP.
DEFAULT_FROM_EMAIL=Le Grand Cinéma <billets@legrandcinema.local>
# Adresse du site utilisée dans les liens envoyés par email.
SITE_URL=http://127.0.0.1:8000
